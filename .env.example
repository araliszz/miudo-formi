NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Use variáveis separadas para não ter problema com @ na senha.
PGHOST=localhost
PGPORT=5432
PGDATABASE=formi
PGUSER=postgres
PGPASSWORD=COLOQUE_SUA_SENHA_LOCAL
SESSION_SECRET=SUBSTITUA_POR_64_CARACTERES_ALEATORIOS
# Local: console escreve o link no terminal; SMTP envia e-mail real.
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FORMI <contato@seu-dominio.com>
# Apenas se o servidor estiver atrás de UM proxy confiável (nginx).
TRUST_PROXY=0

# Dono do programa: preencha seu e-mail para habilitar confirmação adicional.
OWNER_EMAIL=
REGISTRATION_MODE=invite
COMPANY_CREATION_MODE=owner
PG_POOL_MAX=5
PGSSL=false
