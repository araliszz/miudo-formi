# Referência. Na hospedagem use Environment/Secrets, não envie .env ao GitHub.
NODE_ENV=production
APP_URL=https://miudoformi.com.co
SESSION_SECRET=SUBSTITUA_POR_SEGREDO_NOVO_COM_96_CARACTERES_ALEATORIOS
DATABASE_URL=COLOQUE_A_URL_INTERNA_DO_POSTGRESQL_GERENCIADO
# Certificado autoassinado do Render permitido só em hostname privado dpg-*.
PGSSL=render-internal
PG_POOL_MAX=5
TRUST_PROXY=1
OWNER_EMAIL=COLOQUE_SEU_EMAIL_DE_PROPRIETARIO
REGISTRATION_MODE=public
COMPANY_CREATION_MODE=public
MAIL_MODE=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=COLOQUE_A_CHAVE_API_RESEND
MAIL_FROM=FORMI <acesso@miudoformi.com.co>
